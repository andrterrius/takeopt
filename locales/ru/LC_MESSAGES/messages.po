"{bot_username} 10 50 +2 - создаст распределение вариантов от 10 до 50, "
"где можно выбрать уже 2 варианта"
msgstr ""

#: tgbot/query/parser.py:42
msgid "количество вариантов должно быть больше 1"
msgstr ""

#: tgbot/query/parser.py:44
msgid "начальное значение диапазона x должно быть меньше конечного y"
msgstr ""

